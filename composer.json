{
    "name": "statamic/forms-pro",
    "autoload": {
        "psr-4": {
            "Statamic\\FormsPro\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Forms Pro",
            "description": "Forms Pro turns forms into complete experiences and workflows — not just places to collect a name and email address."
        },
        "laravel": {
            "providers": [
                "Statamic\\FormsPro\\ServiceProvider"
            ]
        }
    },
    "require": {
        "statamic/cms": "dev-forms-2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.0",
        "laravel/pint": "^1.29",
        "spatie/laravel-ray": "^1.43.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
